{
  "name": "nest-react-seguro",
  "private": true,
  "workspaces": ["api", "web"],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w api\" \"npm run dev -w web\"",
    "dev:api": "npm run dev -w api",
    "dev:web": "npm run dev -w web",
    "build": "npm run build -w api && npm run build -w web",
    "test": "npm run test -w api",
    "lint": "npm run lint -w web"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.4"
  }
}
